{
	"name": "@graftland/graft",
	"engines": {
		"node": ">=22.19.0"
	},
	"version": "0.5.0",
	"type": "module",
	"description": "A plugin framework built on Effect: plugins, forks, services, isolation, events and logs",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/graftland/graft.git",
		"directory": "packages/core"
	},
	"sideEffects": false,
	"files": [
		"dist",
		"src",
		"README.zh-CN.md",
		"README.zh-TW.md"
	],
	"exports": {
		".": {
			"source": "./src/index.ts",
			"default": "./dist/index.js"
		},
		"./Change": {
			"source": "./src/Change.ts",
			"default": "./dist/Change.js"
		},
		"./Event": {
			"source": "./src/Event.ts",
			"default": "./dist/Event.js"
		},
		"./Finalization": {
			"source": "./src/Finalization.ts",
			"default": "./dist/Finalization.js"
		},
		"./Fork": {
			"source": "./src/Fork.ts",
			"default": "./dist/Fork.js"
		},
		"./Graft": {
			"source": "./src/Graft.ts",
			"default": "./dist/Graft.js"
		},
		"./Kernel": {
			"source": "./src/Kernel.ts",
			"default": "./dist/Kernel.js"
		},
		"./Manifest": {
			"source": "./src/Manifest.ts",
			"default": "./dist/Manifest.js"
		},
		"./Plugin": {
			"source": "./src/Plugin.ts",
			"default": "./dist/Plugin.js"
		},
		"./Transition": {
			"source": "./src/Transition.ts",
			"default": "./dist/Transition.js"
		},
		"./Trust": {
			"source": "./src/Trust.ts",
			"default": "./dist/Trust.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsc -b && tsdown",
		"test": "vitest run"
	},
	"peerDependencies": {
		"effect": "4.1.*"
	},
	"devDependencies": {
		"@effect/vitest": "4.1.2",
		"effect": "4.1.2",
		"vitest": "5.1.0"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.js",
			"./Change": "./dist/Change.js",
			"./Event": "./dist/Event.js",
			"./Finalization": "./dist/Finalization.js",
			"./Fork": "./dist/Fork.js",
			"./Graft": "./dist/Graft.js",
			"./Kernel": "./dist/Kernel.js",
			"./Manifest": "./dist/Manifest.js",
			"./Plugin": "./dist/Plugin.js",
			"./Transition": "./dist/Transition.js",
			"./Trust": "./dist/Trust.js",
			"./package.json": "./package.json"
		}
	}
}
