{
	"name": "@graftland/graft",
	"engines": {
		"node": ">=22.19.0"
	},
	"version": "0.6.0",
	"type": "module",
	"description": "Effect layers that mount and unmount at runtime, with remote services over effect/rpc",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/graftland/graft.git",
		"directory": "packages/core"
	},
	"sideEffects": false,
	"files": [
		"dist",
		"src",
		"README.zh-CN.md",
		"README.zh-TW.md"
	],
	"exports": {
		".": {
			"source": "./src/index.ts",
			"default": "./dist/index.js"
		},
		"./node": {
			"source": "./src/node/index.ts",
			"default": "./dist/node/index.js"
		},
		"./rpc": {
			"source": "./src/rpc/index.ts",
			"default": "./dist/rpc/index.js"
		},
		"./testing": {
			"source": "./src/testing/index.ts",
			"default": "./dist/testing/index.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsc -b && tsdown",
		"test": "vitest run"
	},
	"peerDependencies": {
		"effect": "4.1.*",
		"@effect/platform-node": "4.1.*"
	},
	"peerDependenciesMeta": {
		"@effect/platform-node": {
			"optional": true
		}
	},
	"devDependencies": {
		"@effect/platform-node": "4.1.2",
		"@effect/vitest": "4.1.2",
		"effect": "4.1.2",
		"vitest": "5.1.0"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.js",
			"./node": "./dist/node/index.js",
			"./rpc": "./dist/rpc/index.js",
			"./testing": "./dist/testing/index.js",
			"./package.json": "./package.json"
		}
	}
}
