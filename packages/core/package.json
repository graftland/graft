{
	"name": "@graftland/graft",
	"engines": {
		"node": ">=22.19.0"
	},
	"version": "0.0.0",
	"type": "module",
	"description": "A plugin framework built on Effect: plugins, forks, services, isolation, events and logs",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/graftland/graft.git",
		"directory": "packages/core"
	},
	"sideEffects": false,
	"files": [
		"dist",
		"src",
		"README.zh-CN.md",
		"README.zh-TW.md"
	],
	"exports": {
		".": {
			"source": "./src/index.ts",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsdown",
		"test": "vitest run"
	},
	"peerDependencies": {
		"effect": "4.1.*"
	},
	"devDependencies": {
		"@effect/vitest": "4.1.2",
		"effect": "4.1.2",
		"vitest": "5.1.0"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.js",
			"./package.json": "./package.json"
		}
	}
}
