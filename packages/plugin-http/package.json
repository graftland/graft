{
	"name": "@graftland/plugin-http",
	"version": "0.5.0",
	"type": "module",
	"description": "A shared HTTP server with plugin-scoped routes",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/graftland/graft.git",
		"directory": "packages/plugin-http"
	},
	"files": [
		"dist",
		"src",
		"README.zh-CN.md",
		"README.zh-TW.md"
	],
	"sideEffects": false,
	"exports": {
		".": {
			"source": "./src/index.ts",
			"default": "./dist/index.js"
		},
		"./Authorization": {
			"source": "./src/Authorization.ts",
			"default": "./dist/Authorization.js"
		},
		"./Config": {
			"source": "./src/Config.ts",
			"default": "./dist/Config.js"
		},
		"./Http": {
			"source": "./src/Http.ts",
			"default": "./dist/Http.js"
		},
		"./oauth": {
			"source": "./src/oauth.ts",
			"default": "./dist/oauth.js"
		},
		"./oauth/jwt": {
			"source": "./src/oauth/jwt.ts",
			"default": "./dist/oauth/jwt.js"
		},
		"./router": {
			"source": "./src/router.ts",
			"default": "./dist/router.js"
		},
		"./schema": {
			"source": "./src/schema.ts",
			"default": "./dist/schema.js"
		},
		"./Testing": {
			"source": "./src/Testing.ts",
			"default": "./dist/Testing.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsc -b && tsdown",
		"test": "vitest run"
	},
	"peerDependencies": {
		"effect": "4.1.*",
		"@graftland/graft": "workspace:^"
	},
	"dependencies": {
		"@effect/platform-node": "4.1.2"
	},
	"devDependencies": {
		"@effect/vitest": "4.1.2",
		"effect": "4.1.2",
		"vitest": "5.1.0",
		"@graftland/graft": "workspace:*",
		"@graftland/loader": "workspace:*",
		"@graftland/plugin-remote": "workspace:*"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.js",
			"./Authorization": "./dist/Authorization.js",
			"./Config": "./dist/Config.js",
			"./Http": "./dist/Http.js",
			"./oauth": "./dist/oauth.js",
			"./oauth/jwt": "./dist/oauth/jwt.js",
			"./router": "./dist/router.js",
			"./schema": "./dist/schema.js",
			"./Testing": "./dist/Testing.js",
			"./package.json": "./package.json"
		}
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
