{
	"name": "@graftland/plugin-mcp-server",
	"version": "0.6.0",
	"type": "module",
	"description": "Serves the tools of Graft plugins to MCP clients, reloading them without reconnecting",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/graftland/graft.git",
		"directory": "packages/plugin-mcp-server"
	},
	"files": [
		"dist",
		"src",
		"README.zh-CN.md",
		"README.zh-TW.md"
	],
	"sideEffects": false,
	"exports": {
		".": {
			"source": "./src/index.ts",
			"default": "./dist/index.js"
		},
		"./Catalog": {
			"source": "./src/Catalog.ts",
			"default": "./dist/Catalog.js"
		},
		"./Config": {
			"source": "./src/Config.ts",
			"default": "./dist/Config.js"
		},
		"./Errors": {
			"source": "./src/Errors.ts",
			"default": "./dist/Errors.js"
		},
		"./Extensions": {
			"source": "./src/Extensions.ts",
			"default": "./dist/Extensions.js"
		},
		"./http": {
			"source": "./src/http.ts",
			"default": "./dist/http.js"
		},
		"./Middleware": {
			"source": "./src/Middleware.ts",
			"default": "./dist/Middleware.js"
		},
		"./Projection": {
			"source": "./src/Projection.ts",
			"default": "./dist/Projection.js"
		},
		"./Prompts": {
			"source": "./src/Prompts.ts",
			"default": "./dist/Prompts.js"
		},
		"./Resources": {
			"source": "./src/Resources.ts",
			"default": "./dist/Resources.js"
		},
		"./schema": {
			"source": "./src/schema.ts",
			"default": "./dist/schema.js"
		},
		"./Server": {
			"source": "./src/Server.ts",
			"default": "./dist/Server.js"
		},
		"./stdio": {
			"source": "./src/stdio.ts",
			"default": "./dist/stdio.js"
		},
		"./Testing": {
			"source": "./src/Testing.ts",
			"default": "./dist/Testing.js"
		},
		"./Tools": {
			"source": "./src/Tools.ts",
			"default": "./dist/Tools.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsc -b && tsdown",
		"test": "vitest run"
	},
	"peerDependencies": {
		"effect": "4.1.*",
		"@graftland/graft": "workspace:^",
		"@graftland/cli": "workspace:^",
		"@graftland/plugin-http": "workspace:^",
		"@graftland/plugin-remote": "workspace:^"
	},
	"devDependencies": {
		"@effect/platform-node": "4.1.2",
		"@effect/vitest": "4.1.2",
		"effect": "4.1.2",
		"vitest": "5.1.0",
		"@graftland/graft": "workspace:*",
		"@graftland/cli": "workspace:*",
		"@graftland/loader": "workspace:*",
		"@graftland/plugin-http": "workspace:*",
		"@graftland/plugin-remote": "workspace:*"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.js",
			"./Catalog": "./dist/Catalog.js",
			"./Config": "./dist/Config.js",
			"./Errors": "./dist/Errors.js",
			"./Extensions": "./dist/Extensions.js",
			"./http": "./dist/http.js",
			"./Middleware": "./dist/Middleware.js",
			"./Projection": "./dist/Projection.js",
			"./Prompts": "./dist/Prompts.js",
			"./Resources": "./dist/Resources.js",
			"./schema": "./dist/schema.js",
			"./Server": "./dist/Server.js",
			"./stdio": "./dist/stdio.js",
			"./Testing": "./dist/Testing.js",
			"./Tools": "./dist/Tools.js",
			"./package.json": "./package.json"
		}
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"peerDependenciesMeta": {
		"@graftland/cli": {
			"optional": true
		},
		"@graftland/plugin-http": {
			"optional": true
		},
		"@graftland/plugin-remote": {
			"optional": true
		}
	}
}
