{
	"name": "@nmnmcc/graft-package-manager",
	"version": "0.0.0",
	"type": "module",
	"description": "Package installation with backup and rollback for Graft projects",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nmnmcc/graft.git",
		"directory": "packages/package-manager"
	},
	"sideEffects": false,
	"files": [
		"dist",
		"src"
	],
	"exports": {
		".": {
			"source": "./src/index.ts",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsdown",
		"test": "vitest run"
	},
	"peerDependencies": {
		"effect": "4.1.2"
	},
	"devDependencies": {
		"@effect/vitest": "4.1.2",
		"effect": "4.1.2",
		"vitest": "5.1.0",
		"@effect/platform-node": "4.1.2"
	},
	"dependencies": {},
	"publishConfig": {
		"exports": {
			".": "./dist/index.js",
			"./package.json": "./package.json"
		}
	}
}
