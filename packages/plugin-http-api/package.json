{
	"name": "@graftland/plugin-http-api",
	"version": "0.5.0",
	"type": "module",
	"description": "Live Effect HttpApi groups and OpenAPI documentation",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/graftland/graft.git",
		"directory": "packages/plugin-http-api"
	},
	"files": [
		"dist",
		"src",
		"README.zh-CN.md",
		"README.zh-TW.md"
	],
	"sideEffects": false,
	"exports": {
		".": {
			"source": "./src/index.ts",
			"default": "./dist/index.js"
		},
		"./Config": {
			"source": "./src/Config.ts",
			"default": "./dist/Config.js"
		},
		"./HttpApis": {
			"source": "./src/HttpApis.ts",
			"default": "./dist/HttpApis.js"
		},
		"./scalar": {
			"source": "./src/scalar.ts",
			"default": "./dist/scalar.js"
		},
		"./schema": {
			"source": "./src/schema.ts",
			"default": "./dist/schema.js"
		},
		"./swagger": {
			"source": "./src/swagger.ts",
			"default": "./dist/swagger.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsc -b && tsdown",
		"test": "vitest run"
	},
	"peerDependencies": {
		"effect": "4.1.*",
		"@graftland/graft": "workspace:^",
		"@graftland/plugin-http": "workspace:^"
	},
	"devDependencies": {
		"@effect/vitest": "4.1.2",
		"effect": "4.1.2",
		"vitest": "5.1.0",
		"@graftland/graft": "workspace:*",
		"@graftland/loader": "workspace:*",
		"@graftland/plugin-http": "workspace:*",
		"yaml": "2.9.1",
		"@effect/platform-node": "4.1.2",
		"@graftland/plugin-remote": "workspace:*"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.js",
			"./Config": "./dist/Config.js",
			"./HttpApis": "./dist/HttpApis.js",
			"./scalar": "./dist/scalar.js",
			"./schema": "./dist/schema.js",
			"./swagger": "./dist/swagger.js",
			"./package.json": "./package.json"
		}
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
