{
	"name": "@graftland/remote",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Local and authenticated network execution for Graft plugins",
	"sideEffects": false,
	"exports": {
		".": {
			"source": "./src/index.ts",
			"default": "./dist/index.js"
		},
		"./Auth": {
			"source": "./src/Auth.ts",
			"default": "./dist/Auth.js"
		},
		"./bin": "./dist/bin.js",
		"./host/auth/mtls": {
			"source": "./src/host/auth/mtls.ts",
			"default": "./dist/host/auth/mtls.js"
		},
		"./host/local": {
			"source": "./src/host/local.ts",
			"default": "./dist/host/local.js"
		},
		"./host/websocket": {
			"source": "./src/host/websocket.ts",
			"default": "./dist/host/websocket.js"
		},
		"./Runner": {
			"source": "./src/Runner.ts",
			"default": "./dist/Runner.js"
		},
		"./runner/auth/mtls": {
			"source": "./src/runner/auth/mtls.ts",
			"default": "./dist/runner/auth/mtls.js"
		},
		"./runner/supervisor": {
			"source": "./src/runner/supervisor.ts",
			"default": "./dist/runner/supervisor.js"
		},
		"./runner/websocket": {
			"source": "./src/runner/websocket.ts",
			"default": "./dist/runner/websocket.js"
		},
		"./Supervisor": {
			"source": "./src/Supervisor.ts",
			"default": "./dist/Supervisor.js"
		},
		"./Transport": {
			"source": "./src/Transport.ts",
			"default": "./dist/Transport.js"
		},
		"./watchdog": "./dist/watchdog.js",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsdown",
		"test": "vitest run"
	},
	"peerDependencies": {
		"effect": "4.1.*"
	},
	"dependencies": {
		"@graftland/graft": "workspace:*",
		"@effect/platform-node": "4.1.2",
		"@graftland/loader": "workspace:*",
		"pkijs": "4.0.1",
		"asn1js": "4.0.0",
		"ws": "8.22.1"
	},
	"devDependencies": {
		"@effect/vitest": "4.1.2",
		"effect": "4.1.2",
		"vitest": "5.1.0",
		"@types/ws": "8.18.2"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.js",
			"./Auth": "./dist/Auth.js",
			"./bin": "./dist/bin.js",
			"./host/auth/mtls": "./dist/host/auth/mtls.js",
			"./host/local": "./dist/host/local.js",
			"./host/websocket": "./dist/host/websocket.js",
			"./Runner": "./dist/Runner.js",
			"./runner/auth/mtls": "./dist/runner/auth/mtls.js",
			"./runner/supervisor": "./dist/runner/supervisor.js",
			"./runner/websocket": "./dist/runner/websocket.js",
			"./Supervisor": "./dist/Supervisor.js",
			"./Transport": "./dist/Transport.js",
			"./watchdog": "./dist/watchdog.js",
			"./package.json": "./package.json"
		}
	},
	"bin": {
		"graft-remote": "./dist/bin.js"
	}
}
