{
	"name": "@graftland/remote",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Local and authenticated network execution for Graft plugins",
	"sideEffects": false,
	"exports": {
		".": {
			"source": "./src/index.ts",
			"default": "./dist/index.js"
		},
		"./bin": "./dist/bin.js",
		"./Runner": {
			"source": "./src/Runner.ts",
			"default": "./dist/Runner.js"
		},
		"./watchdog": "./dist/watchdog.js",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsdown",
		"test": "vitest run"
	},
	"peerDependencies": {
		"effect": "4.1.*"
	},
	"dependencies": {
		"@graftland/graft": "workspace:*",
		"@effect/platform-node": "4.1.2",
		"@graftland/loader": "workspace:*"
	},
	"devDependencies": {
		"@effect/vitest": "4.1.2",
		"effect": "4.1.2",
		"vitest": "5.1.0"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.js",
			"./bin": "./dist/bin.js",
			"./Runner": "./dist/Runner.js",
			"./watchdog": "./dist/watchdog.js",
			"./package.json": "./package.json"
		}
	},
	"bin": {
		"graft-remote": "./dist/bin.js"
	}
}
