{
	"name": "@graftland/cli",
	"version": "0.0.0",
	"type": "module",
	"engines": {
		"node": ">=22.19.0"
	},
	"description": "The graft command: start, create, add and remove",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/graftland/graft.git",
		"directory": "packages/cli"
	},
	"sideEffects": false,
	"files": [
		"dist",
		"src",
		"schema.json",
		"README.zh-CN.md",
		"README.zh-TW.md"
	],
	"exports": {
		".": {
			"source": "./src/index.ts",
			"default": "./dist/index.js"
		},
		"./Application": {
			"source": "./src/Application.ts",
			"default": "./dist/Application.js"
		},
		"./bin": {
			"source": "./src/bin.ts",
			"default": "./dist/bin.js"
		},
		"./Commands": {
			"source": "./src/Commands.ts",
			"default": "./dist/Commands.js"
		},
		"./internal/configSchema": {
			"source": "./src/internal/configSchema.ts",
			"default": "./dist/internal/configSchema.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsc -b && tsdown && node scripts/schema.mjs",
		"test": "vitest run"
	},
	"peerDependencies": {
		"effect": "4.1.*",
		"@graftland/graft": "workspace:^",
		"@graftland/loader": "workspace:^"
	},
	"devDependencies": {
		"@effect/vitest": "4.1.2",
		"effect": "4.1.2",
		"vitest": "5.1.0",
		"@graftland/graft": "workspace:*",
		"@graftland/loader": "workspace:*"
	},
	"dependencies": {
		"@graftland/hmr": "workspace:*",
		"@graftland/create": "workspace:*",
		"@graftland/package-manager": "workspace:*",
		"@effect/platform-node": "4.1.2",
		"yaml": "2.9.1"
	},
	"bin": {
		"graft": "./dist/bin.js"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.js",
			"./Application": "./dist/Application.js",
			"./bin": "./dist/bin.js",
			"./Commands": "./dist/Commands.js",
			"./internal/configSchema": "./dist/internal/configSchema.js",
			"./package.json": "./package.json"
		}
	}
}
