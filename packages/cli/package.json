{
	"name": "@graftland/cli",
	"version": "0.0.0",
	"type": "module",
	"engines": {
		"node": ">=22.15.0"
	},
	"description": "The graft command: start, create, add and remove",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/graftland/graft.git",
		"directory": "packages/cli"
	},
	"sideEffects": false,
	"files": [
		"dist",
		"src"
	],
	"exports": {
		".": {
			"source": "./src/index.ts",
			"default": "./dist/index.js"
		},
		"./bin": {
			"source": "./src/bin.ts",
			"default": "./dist/bin.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsdown",
		"test": "vitest run"
	},
	"peerDependencies": {
		"effect": "4.1.2"
	},
	"devDependencies": {
		"@effect/vitest": "4.1.2",
		"effect": "4.1.2",
		"vitest": "5.1.0"
	},
	"dependencies": {
		"@graftland/graft": "workspace:*",
		"@graftland/loader": "workspace:*",
		"@graftland/hmr": "workspace:*",
		"@graftland/create": "workspace:*",
		"@graftland/package-manager": "workspace:*",
		"@effect/platform-node": "4.1.2"
	},
	"bin": {
		"graft": "./dist/bin.js"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.js",
			"./bin": "./dist/bin.js",
			"./package.json": "./package.json"
		}
	}
}
