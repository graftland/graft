{
	"name": "@graftland/plugin-remote",
	"version": "0.0.0",
	"type": "module",
	"description": "Native unit execution and encoded contracts for Graft",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/graftland/graft.git",
		"directory": "packages/plugin-remote"
	},
	"files": [
		"dist",
		"src",
		"README.zh-CN.md",
		"README.zh-TW.md"
	],
	"sideEffects": false,
	"exports": {
		".": {
			"source": "./src/index.ts",
			"default": "./dist/index.js"
		},
		"./Artifact": {
			"source": "./src/Artifact.ts",
			"default": "./dist/Artifact.js"
		},
		"./Capabilities": {
			"source": "./src/Capabilities.ts",
			"default": "./dist/Capabilities.js"
		},
		"./Configuration": {
			"source": "./src/Configuration.ts",
			"default": "./dist/Configuration.js"
		},
		"./Conformance": {
			"source": "./src/Conformance.ts",
			"default": "./dist/Conformance.js"
		},
		"./Contract": {
			"source": "./src/Contract.ts",
			"default": "./dist/Contract.js"
		},
		"./Control": {
			"source": "./src/Control.ts",
			"default": "./dist/Control.js"
		},
		"./Errors": {
			"source": "./src/Errors.ts",
			"default": "./dist/Errors.js"
		},
		"./Policy": {
			"source": "./src/Policy.ts",
			"default": "./dist/Policy.js"
		},
		"./Publication": {
			"source": "./src/Publication.ts",
			"default": "./dist/Publication.js"
		},
		"./Testing": {
			"source": "./src/Testing.ts",
			"default": "./dist/Testing.js"
		},
		"./Transport": {
			"source": "./src/Transport.ts",
			"default": "./dist/Transport.js"
		},
		"./Units": {
			"source": "./src/Units.ts",
			"default": "./dist/Units.js"
		},
		"./package.json": "./package.json",
		"./kernel": "./dist/internal/kernelMain.js",
		"./internal/unit": "./dist/internal/nativeUnitMain.js",
		"./internal/publication": "./dist/internal/publicationMain.js"
	},
	"scripts": {
		"build": "tsc -b && tsdown",
		"test": "vitest run"
	},
	"peerDependencies": {
		"effect": "4.1.*",
		"@graftland/graft": "workspace:^"
	},
	"dependencies": {
		"@effect/platform-node": "4.1.2"
	},
	"devDependencies": {
		"@effect/vitest": "4.1.2",
		"effect": "4.1.2",
		"vitest": "5.1.0",
		"@graftland/graft": "workspace:*"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.js",
			"./Artifact": "./dist/Artifact.js",
			"./Capabilities": "./dist/Capabilities.js",
			"./Configuration": "./dist/Configuration.js",
			"./Conformance": "./dist/Conformance.js",
			"./Contract": "./dist/Contract.js",
			"./Control": "./dist/Control.js",
			"./Errors": "./dist/Errors.js",
			"./Policy": "./dist/Policy.js",
			"./Publication": "./dist/Publication.js",
			"./Testing": "./dist/Testing.js",
			"./Transport": "./dist/Transport.js",
			"./Units": "./dist/Units.js",
			"./package.json": "./package.json",
			"./kernel": "./dist/internal/kernelMain.js",
			"./internal/unit": "./dist/internal/nativeUnitMain.js",
			"./internal/publication": "./dist/internal/publicationMain.js"
		}
	},
	"engines": {
		"node": ">=22.19.0"
