{
	"name": "@graftland/plugin-otlp",
	"version": "0.0.0",
	"type": "module",
	"description": "Exports the spans of Graft plugins to an OpenTelemetry collector over OTLP/HTTP",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/graftland/graft.git",
		"directory": "packages/plugin-otlp"
	},
	"files": [
		"dist",
		"src",
		"README.zh-CN.md",
		"README.zh-TW.md"
	],
	"sideEffects": false,
	"exports": {
		".": {
			"source": "./src/index.ts",
			"default": "./dist/index.js"
		},
		"./Config": {
			"source": "./src/Config.ts",
			"default": "./dist/Config.js"
		},
		"./Exporter": {
			"source": "./src/Exporter.ts",
			"default": "./dist/Exporter.js"
		},
		"./http": {
			"source": "./src/http.ts",
			"default": "./dist/http.js"
		},
		"./schema": {
			"source": "./src/schema.ts",
			"default": "./dist/schema.js"
		},
		"./Testing": {
			"source": "./src/Testing.ts",
			"default": "./dist/Testing.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsc -b && tsdown",
		"test": "vitest run"
	},
	"peerDependencies": {
		"effect": "4.1.*",
		"@graftland/graft": "workspace:^",
		"@graftland/loader": "workspace:^"
	},
	"devDependencies": {
		"@effect/platform-node": "4.1.2",
		"@effect/vitest": "4.1.2",
		"effect": "4.1.2",
		"vitest": "5.1.0",
		"@graftland/graft": "workspace:*",
		"@graftland/loader": "workspace:*",
		"@graftland/plugin-remote": "workspace:*"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.js",
			"./Config": "./dist/Config.js",
			"./Exporter": "./dist/Exporter.js",
			"./http": "./dist/http.js",
			"./schema": "./dist/schema.js",
			"./Testing": "./dist/Testing.js",
			"./package.json": "./package.json"
		}
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
