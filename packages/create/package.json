{
	"name": "@graftland/create",
	"engines": {
		"node": ">=22.19.0"
	},
	"version": "0.6.0",
	"type": "module",
	"description": "Generates a new Graft project: npm create @graftland, and graft create",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/graftland/graft.git",
		"directory": "packages/create"
	},
	"sideEffects": false,
	"files": [
		"dist",
		"src",
		"templates",
		"README.zh-CN.md",
		"README.zh-TW.md"
	],
	"exports": {
		".": {
			"source": "./src/index.ts",
			"default": "./dist/index.js"
		},
		"./bin": {
			"source": "./src/bin.ts",
			"default": "./dist/bin.js"
		},
		"./Command": {
			"source": "./src/Command.ts",
			"default": "./dist/Command.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsc -b && tsdown",
		"test": "vitest run"
	},
	"peerDependencies": {
		"effect": "4.1.*"
	},
	"devDependencies": {
		"@effect/vitest": "4.1.2",
		"@graftland/graft": "workspace:*",
		"@graftland/loader": "workspace:*",
		"effect": "4.1.2",
		"vitest": "5.1.0",
		"yaml": "2.9.1"
	},
	"dependencies": {
		"@graftland/package-manager": "workspace:*",
		"@effect/platform-node": "4.1.2"
	},
	"bin": {
		"create": "./dist/bin.js"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.js",
			"./bin": "./dist/bin.js",
			"./Command": "./dist/Command.js",
			"./package.json": "./package.json"
		}
	}
}
