{
	"name": "@graftland/sample-http-gateway",
	"private": true,
	"type": "module",
	"description": "A real HTTP server whose routes come from plugins listed in graft.yml",
	"scripts": {
		"start": "graft start --watch",
		"test": "vitest run"
	},
	"dependencies": {
