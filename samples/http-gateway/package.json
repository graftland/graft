		"effect": "4.1.2",
		"@graftland/plugin-http": "workspace:*",
		"@graftland/plugin-http-api": "workspace:*"
	},
	"devDependencies": {
		"@effect/vitest": "4.1.2",
		"vitest": "5.1.0"
	}
}
