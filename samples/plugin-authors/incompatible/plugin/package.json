{
	"name": "@incompatible/plugin",
	"version": "1.0.0",
	"type": "module",
	"author": "Incompatible fixture",
	"exports": {
		".": "./dist/index.js",
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=99.0.0"
	},
	"peerDependencies": {
		"effect": "4.1.*",
		"@graftland/graft": "0.0.0",
		"@graftland/plugin-remote": "0.0.0",
		"@alice/conformance-echo-contract": "1.0.0"
	},
	"graft": {
		"version": 1,
		"entries": {
			".": {
				"implementation": "dist/index.js",
				"contracts": [
					"@alice/conformance-echo-contract"
				],
				"requirements": {
					"placements": [
						"Worker",
						"Local"
					],
					"filesystem": false,
					"nativeModules": false
				},
				"probes": []
			}
		}
	}
}
