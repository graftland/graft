{
  pkgs,
  multiverse,
  ...
}:

{
  devenv.warnOnNewVersion = false;

  packages = with pkgs; [
    git
    gh
    corepack
    ripgrep
  ];

  languages = {
    javascript = {
      enable = true;
      lsp.enable = false;
      package = multiverse.nodejs_26."26.12.1";
    };
  };

  treefmt = {
    enable = true;
    config = {
      projectRootFile = "devenv.nix";
      settings.global.excludes = [
        ".agents/**"
        ".claude/**"
        "references/**"
        # Generated by the plugin-remote build and read by the CLI build, which runs first.
        "packages/plugin-remote/schema.json"
      ];
      programs = {
        prettier.enable = true;
        nixfmt.enable = true;
      };
    };
  };
}
